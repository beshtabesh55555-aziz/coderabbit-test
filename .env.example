# JARVIS Configuration Environment Template
# Copy this file to .env and fill in your values

# Google Gemini API Key (for Multimodal Brain & Vision Analysis)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Telegram Bot Settings (for Remote Monitoring & Alerts)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=

# Camera & Vision Settings
CAMERA_INDEX=0
MOTION_DETECTION_SENSITIVITY=25
MOTION_MIN_AREA=5000
MOTION_ALERT_COOLDOWN_SECONDS=10

# Voice & Speech Settings
VOICE_LANGUAGE=uz
# Options: 'uz-UZ-MadinaNeural' (female), 'uz-UZ-SardorNeural' (male), 'en-US-ChristopherNeural' (Jarvis)
TTS_VOICE=uz-UZ-SardorNeural
WAKE_WORDS=jarvis,salom jarvis,hey jarvis
