# =================================================================
# JARVIS / Monika AI - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to public version control!
# =================================================================

# Assistant Identity
ASSISTANT_NAME=Monika

# AI Model Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# WebApp Remote Control & Authentication
WEBAPP_API_KEY=your_secure_random_webapp_key_here
ADMIN_PIN=1234
HOST=0.0.0.0
PORT=8088

# Vision & Camera Settings
CAMERA_INDEX=0
MOTION_DETECTION_SENSITIVITY=25
MOTION_MIN_AREA=4000
MOTION_ALERT_COOLDOWN_SECONDS=20

# Voice & Speech Synthesis
VOICE_LANGUAGE=uz
TTS_VOICE=uz-UZ-MadinaNeural
WAKE_WORDS=monika,monica,monikaxon,madina,salom monika,hey monika,jarvis

# Local LLM Fallback (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
